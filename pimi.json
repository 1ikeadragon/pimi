{
  "worktree": {
    "setup": [
      "npm ci",
      "npm run setup",
      "node ./scripts/seed-ios-native-cache.mjs",
      "node ./scripts/seed-worktree-dev-state.mjs",
      "npm run build:server",
      "npm run build --workspace=@pimi/expo-two-way-audio"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "PIMI_DEV_MANAGED_HOME=1 PIMI_DEV_ROOT=\"${PIMI_WORKTREE_PATH:-$PWD}\" PIMI_HOME=\"${PIMI_WORKTREE_PATH:-$PWD}/.dev/pimi-home\" PIMI_SKIP_DEV_SERVER_BUILD=1 PIMI_LISTEN=0.0.0.0:${PIMI_PORT:-6768} ./scripts/dev-daemon.sh"
    },
    "app": {
      "type": "service",
      "command": "PIMI_DEV_MANAGED_HOME=1 PIMI_DEV_ROOT=\"${PIMI_WORKTREE_PATH:-$PWD}\" PIMI_HOME=\"${PIMI_WORKTREE_PATH:-$PWD}/.dev/pimi-home\" PIMI_LISTEN=0.0.0.0:${PIMI_SERVICE_DAEMON_PORT:-6768} PIMI_DEV_DAEMON_ENDPOINT=localhost:${PIMI_SERVICE_DAEMON_PORT:-6768} EXPO_PORT=${PIMI_PORT:-} ./scripts/dev-app.sh"
    },
    "desktop": {
      "type": "service",
      "command": "PIMI_DEV_MANAGED_HOME=1 PIMI_DEV_ROOT=\"${PIMI_WORKTREE_PATH:-$PWD}\" PIMI_HOME=\"${PIMI_WORKTREE_PATH:-$PWD}/.dev/pimi-home\" PIMI_LISTEN=0.0.0.0:${PIMI_SERVICE_DAEMON_PORT:-6768} PIMI_DEV_DAEMON_ENDPOINT=localhost:${PIMI_SERVICE_DAEMON_PORT:-6768} EXPO_PORT=${PIMI_PORT:-} exec ./packages/desktop/scripts/dev.sh"
    },
    "ios-simulator": {
      "type": "service",
      "command": "PIMI_DEV_MANAGED_HOME=1 PIMI_DEV_ROOT=\"$PWD\" PIMI_HOME=\"$PWD/.dev/pimi-home\" PIMI_LISTEN=0.0.0.0:${PIMI_SERVICE_DAEMON_PORT} PIMI_DEV_DAEMON_ENDPOINT=localhost:${PIMI_SERVICE_DAEMON_PORT} ./scripts/pimi-ios-simulator-service.sh"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
