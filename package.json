{
  "name": "pimi",
  "version": "0.17.9",
  "private": true,
  "description": "Pimi desktop workspace for AI coding agents",
  "keywords": [
    "development",
    "mcp",
    "openai",
    "voice",
    "voice-assistant"
  ],
  "homepage": "https://1ikeadragon.github.io/pimi/",
  "license": "Apache-2.0",
  "author": {
    "name": "Pimi contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1ikeadragon/pimi.git"
  },
  "workspaces": [
    "plugins",
    "packages/expo-two-way-audio",
    "packages/highlight",
    "packages/plugin",
    "packages/protocol",
    "packages/client",
    "packages/server",
    "packages/app",
    "packages/relay",
    "packages/desktop",
    "packages/cli"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:win": "powershell ./scripts/dev.ps1",
    "dev:server": "cross-env PASEO_LISTEN=127.0.0.1:6768 ./scripts/dev-daemon.sh",
    "dev:server:watch": "concurrently --kill-others --names protocol,client,server --prefix-colors yellow,blue,cyan \"npm run watch:protocol\" \"npm run watch:client\" \"npm run dev:server:raw\"",
    "dev:server:raw": "npm run dev --workspace=@pimi/server",
    "dev:app": "cross-env PASEO_LISTEN=127.0.0.1:6768 EXPO_PORT=8081 ./scripts/dev-app.sh",
    "dev:android": "npm run dev:android --workspace=@pimi/app",
    "dev:ios": "npm run dev:ios --workspace=@pimi/app",
    "test:e2e:mobile": "./scripts/test-mobile-agent-device.sh",
    "test:e2e:composer-keyboard:android": "./packages/app/e2e/mobile/composer-keyboard/android.sh",
    "postinstall": "node scripts/postinstall-patches.mjs && node scripts/prepare-native-markdown.mjs --if-installed",
    "prepare": "lefthook install --force",
    "build": "npm run build --workspaces --if-present",
    "build:apk": "node scripts/build-apk.mjs",
    "build:apk:arm64": "node scripts/build-apk.mjs arm64",
    "pimi:package:android": "node scripts/build-apk.mjs --pimi",
    "build:highlight": "npm run build --workspace=@pimi/highlight",
    "build:highlight:clean": "npm run build:clean --workspace=@pimi/highlight",
    "build:plugin": "npm run build --workspace=@pimi/plugin",
    "build:plugin:clean": "npm run build:clean --workspace=@pimi/plugin",
    "build:relay": "npm run build --workspace=@pimi/relay",
    "build:relay:clean": "npm run build:clean --workspace=@pimi/relay",
    "build:protocol": "npm run build --workspace=@pimi/protocol",
    "build:protocol:clean": "npm run build:clean --workspace=@pimi/protocol",
    "build:client": "npm run build --workspace=@pimi/client",
    "build:client:clean": "npm run build:protocol:clean && npm run build:clean --workspace=@pimi/client",
    "build:server-deps": "npm run build:client && concurrently --kill-others-on-fail --names highlight,plugin,relay --prefix-colors yellow,green,blue \"npm run build:highlight\" \"npm run build:plugin\" \"npm run build:relay\"",
    "build:server-deps:clean": "npm run build:client:clean && npm run build:highlight:clean && npm run build:plugin:clean && npm run build:relay:clean",
    "build:server": "npm run build:server-deps && npm run build --workspace=@pimi/server && npm run build --workspace=@pimi/cli",
    "build:server:clean": "npm run build:server-deps:clean && npm run build:clean --workspace=@pimi/server && npm run build:clean --workspace=@pimi/cli",
    "build:daemon-web-ui": "node scripts/build-daemon-web-ui.mjs",
    "build:app-deps": "npm run build:highlight && npm run build:client && npm run build:plugin && npm run build --workspace=@pimi/expo-two-way-audio",
    "build:app-deps:clean": "npm run build:highlight:clean && npm run build:client:clean && npm run build:plugin:clean && npm run build --workspace=@pimi/expo-two-way-audio",
    "watch:protocol": "npm run watch --workspace=@pimi/protocol",
    "watch:client": "tsc -p packages/client/tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:server": "npm run typecheck --workspace=@pimi/relay && npm run typecheck --workspace=@pimi/protocol && npm run typecheck --workspace=@pimi/client && npm run typecheck --workspace=@pimi/builtin-plugins && npm run typecheck --workspace=@pimi/server && npm run typecheck --workspace=@pimi/cli",
    "test": "npm run test --workspaces --if-present",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "acp:version-drift": "node scripts/check-acp-catalog-version-drift.mjs",
    "acp:version-drift:check": "node scripts/check-acp-catalog-version-drift.mjs --fail-on-drift",
    "acp:version-drift:update": "node scripts/check-acp-catalog-version-drift.mjs --update",
    "start": "npm run start --workspace=@pimi/server",
    "android": "npm run dev:android",
    "android:development": "npm run android:development --workspace=@pimi/app",
    "android:production": "npm run android:production --workspace=@pimi/app",
    "android:release": "npm run android:production --workspace=@pimi/app",
    "android:clear": "npm run android:clear --workspace=@pimi/app",
    "ios": "npm run dev:ios",
    "web": "npm run web --workspace=@pimi/app",
    "dev:desktop": "cross-env PASEO_LISTEN=127.0.0.1:6768 npm run dev --workspace=@pimi/desktop",
    "dev:win:desktop": "npm run dev:win --workspace=@pimi/desktop",
    "build:desktop": "npm run build:app-deps:clean && cd packages/app && cross-env PASEO_WEB_PLATFORM=electron npx expo export --platform web && cd ../.. && npm run build --workspace=@pimi/desktop --",
    "db:query": "npm run db:query --workspace=@pimi/server --",
    "cli": "./scripts/dev-home.sh npx tsx packages/cli/src/index.js",
    "version:sync-internal": "node scripts/sync-workspace-versions.mjs",
    "pimi": "node pimi/server.mjs",
    "pimi:desktop": "cross-env PIMI_DESKTOP=1 npm run dev --workspace=@pimi/desktop",
    "pimi:prepare:desktop": "npm run build:server && cross-env PASEO_WEB_PLATFORM=electron npm run build:web --workspace=@pimi/app && npm run build:main --workspace=@pimi/desktop",
    "pimi:package:mac": "npm run pimi:prepare:desktop && npm exec --workspace=@pimi/desktop -- electron-builder --config electron-builder.pimi.yml --mac dmg --arm64 --publish never",
    "pimi:package:win": "node -e \"if (process.platform !== 'win32' || process.arch !== 'x64') throw new Error('Run this command on Windows with x64 Node.js and run npm ci first.')\" && npm run pimi:prepare:desktop && npm exec --workspace=@pimi/desktop -- electron-builder --config electron-builder.pimi.yml --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "@vercel/nft": "^1.5.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "expo-module-scripts": "^5.0.8",
    "get-port-cli": "^3.0.0",
    "js-yaml": "4.3.2",
    "knip": "^5.82.1",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "ws": "8.22.2"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs@7": "7.29.8",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6",
    "@electron/get@^3.0.0": {
      "semver@^6": "6.3.1"
    },
    "@xmldom/xmldom@<0.9": "0.8.15",
    "axios": "1.21.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "browserslist@4": "4.28.7",
    "decode-uri-component": "0.5.1",
    "dompurify": "3.4.17",
    "expo": "57.0.32",
    "expo-router": "57.0.30",
    "express@4": {
      "body-parser": "1.20.9"
    },
    "express@5": {
      "body-parser": "2.4.0"
    },
    "fast-uri@3": "3.1.9",
    "form-data@4": "4.0.6",
    "hono": "4.13.17",
    "ip-address": "10.7.6",
    "joi": "18.3.2",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "lightningcss": "1.30.1",
    "lodash@4": "4.18.1",
    "minimatch@5": "5.1.8",
    "minimatch@>=7": "11.0.5",
    "node-forge@1": "1.4.3",
    "picomatch@2": "2.3.2",
    "pkijs": "3.4.2",
    "postcss": "8.5.30",
    "proxy-addr": "2.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.5",
    "react-native-worklets": "0.10.4",
    "shell-quote": "1.12.0",
    "smol-toml@1": "1.9.1",
    "tar@7": "7.5.22",
    "tiny-async-pool": {
      "semver@^5": "5.7.2"
    },
    "tinypool@2": "2.1.2",
    "tmp@0.2": "0.2.7",
    "vite": "7.3.7",
    "ws@7": "7.5.13"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  }
}
