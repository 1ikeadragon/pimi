<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Default priority 0 beats expo-notifications' -1, so this service receives FCM messages first. -->
    <service android:name=".PimiFirebaseMessagingService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
