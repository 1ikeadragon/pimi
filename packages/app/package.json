{
  "name": "@pimi/app",
  "version": "0.17.47",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run start:expo",
    "start:expo": "cross-env APP_VARIANT=development expo start",
    "android": "npm run dev:android",
    "android:development": "npm run dev:android",
    "android:production": "npm --prefix ../.. run build:client && cross-env APP_VARIANT=production expo prebuild --platform android --template ../../node_modules/expo/template.tgz --clean --non-interactive && cross-env APP_VARIANT=production expo run:android --variant=release",
    "android:release": "npm run android:production",
    "android:clear": "node -e \"require('node:fs').rmSync('android', { recursive: true, force: true })\"",
    "ios": "npm run dev:ios",
    "ios:release": "npm --prefix ../.. run build:client && expo run:ios --configuration Release",
    "typecheck": "tsgo --noEmit",
    "build:renderer": "npm --prefix ../.. run build:app-deps && cross-env PIMI_WEB_PLATFORM=electron expo export --platform web",
    "profile:composer-typing": "node ./scripts/profile-composer-typing.mjs",
    "profile:explorer-toggle": "node ./scripts/profile-explorer-toggle.mjs",
    "profile:workspace-switching": "node ./scripts/profile-workspace-switching.mjs",
    "profile:workspace-tabs": "node ./scripts/profile-workspace-tabs.mjs",
    "build:mermaid-runtime": "node ./src/components/markdown/fence/mermaid/build-runtime.mjs",
    "dev:android": "npm --prefix ../.. run build:client && cross-env APP_VARIANT=development expo prebuild --platform android --template ../../node_modules/expo/template.tgz --clean --non-interactive && cross-env APP_VARIANT=development expo run:android --variant=debug",
    "dev:ios": "npm --prefix ../.. run build:client && cross-env APP_VARIANT=development expo run:ios",
    "build:apk": "npm --prefix ../.. run build:apk",
    "build:apk:arm64": "npm --prefix ../.. run build:apk:arm64"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
