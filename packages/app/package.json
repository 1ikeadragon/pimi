    "@types/react-dom": "19.2.7",
    "@types/turndown": "5.0.6",
    "@xterm/headless": "6.1.0-beta.334",
    "babel-preset-expo": "57.0.17",
    "esbuild": "0.28.1",
    "expo-gradle-jvmargs": "1.1.2",
    "serve-sim": "0.1.40",
    "typescript": "5.9.3"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "json",
      "html",
      "css",
      "markdown",
      "yaml",
      "go",
      "java",
      "javascript",
      "python",
      "c",
      "rust",
      "bash",
      "typescript",
      "tsx",
      "cpp",
      "swift",
      "php",
      "ruby",
      "c-sharp"
    ],
    "enableVideo": false
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
}
