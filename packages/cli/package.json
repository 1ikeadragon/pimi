{
  "name": "@pimi/cli",
  "version": "0.17.37",
  "private": true,
  "description": "Pimi CLI - control your AI coding agents from the command line",
  "license": "Apache-2.0",
  "bin": {
    "pimi": "bin/pimi"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.1.0",
    "@pimi/client": "0.17.37",
    "@pimi/protocol": "0.17.37",
    "@pimi/server": "0.17.37",
    "commander": "12.1.0",
    "mime-types": "2.1.35",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mime-types": "3.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
