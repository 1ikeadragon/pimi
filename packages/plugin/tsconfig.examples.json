{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "react-native-svg": ["../app/node_modules/react-native-svg"],
      "react-native-gesture-handler": ["../app/node_modules/react-native-gesture-handler"],
      "react-native-reanimated": ["../app/node_modules/react-native-reanimated"],
      "react-native-safe-area-context": ["../app/node_modules/react-native-safe-area-context"]
    }
  },
  "include": ["../../plugin-examples/**/*.ts", "../../plugin-examples/**/*.tsx"]
}
