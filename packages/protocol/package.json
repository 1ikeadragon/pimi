{
  "name": "@pimi/protocol",
  "version": "0.17.19",
  "private": true,
  "description": "Pimi shared protocol schemas and wire types",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addresses": {
      "types": "./dist/addresses.d.ts",
      "default": "./dist/addresses.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run generate:validators && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "npm run generate:validators && tsgo --noEmit",
    "generate:validators": "node scripts/generate-validation-aot.mjs",
    "watch": "concurrently --kill-others --names validation,tsc --prefix-colors green,yellow \"node scripts/watch-validation-aot.mjs\" \"tsc -p tsconfig.json --watch --preserveWatchOutput\""
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/semver": "7.8.0",
    "typescript": "5.9.3",
    "zod-aot": "0.20.4"
  }
}
