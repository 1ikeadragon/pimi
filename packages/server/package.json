{
  "name": "@pimi/server",
  "version": "0.17.30",
  "private": true,
  "description": "Pimi backend server",
  "license": "Apache-2.0",
  "files": [
    "dist/server",
    "dist/src",
    "dist/scripts",
    "!dist/**/*.map",
    "README.md",
    ".env.example"
  ],
  "type": "module",
  "types": "./dist/server/server/exports.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/server/exports.d.ts",
      "source": "./src/server/exports.ts",
      "default": "./dist/server/server/exports.js"
    },
    "./utils/tool-call-parsers": {
      "types": "./dist/server/utils/tool-call-parsers.d.ts",
      "source": "./src/utils/tool-call-parsers.ts",
      "default": "./dist/server/utils/tool-call-parsers.js"
    },
    "./agent-hooks": {
      "types": "./dist/server/terminal/agent-hooks/provider-registry.d.ts",
      "source": "./src/terminal/agent-hooks/provider-registry.ts",
      "default": "./dist/server/terminal/agent-hooks/provider-registry.js"
    },
    "./daemon-control": {
      "types": "./dist/server/server/daemon-instance.d.ts",
      "source": "./src/server/daemon-instance.ts",
      "default": "./dist/server/server/daemon-instance.js"
    },
    "./configuration": {
      "types": "./dist/server/server/config.d.ts",
      "source": "./src/server/config.ts",
      "default": "./dist/server/server/config.js"
    },
    "./process": {
      "types": "./dist/server/utils/spawn.d.ts",
      "source": "./src/utils/spawn.ts",
      "default": "./dist/server/utils/spawn.js"
    },
    "./auth": {
      "types": "./dist/server/server/auth.d.ts",
      "source": "./src/server/auth.ts",
      "default": "./dist/server/server/auth.js"
    },
    "./network-activity": {
      "types": "./dist/server/server/network/activity.d.ts",
      "source": "./src/server/network/activity.ts",
      "default": "./dist/server/server/network/activity.js"
    },
    "./process-launch": {
      "types": "./dist/server/utils/process-launch.d.ts",
      "source": "./src/utils/process-launch.ts",
      "default": "./dist/server/utils/process-launch.js"
    },
    "./process-launch-recorder": {
      "types": "./dist/server/server/network/process-launch-recorder.d.ts",
      "source": "./src/server/network/process-launch-recorder.ts",
      "default": "./dist/server/server/network/process-launch-recorder.js"
    },
    "./network-redact": {
      "types": "./dist/server/server/network/redact.d.ts",
      "source": "./src/server/network/redact.ts",
      "default": "./dist/server/server/network/redact.js"
    },
    "./network-log": {
      "types": "./dist/server/server/network/log-store.d.ts",
      "source": "./src/server/network/log-store.ts",
      "default": "./dist/server/server/network/log-store.js"
    },
    "./pairing": {
      "types": "./dist/server/server/pairing-offer.d.ts",
      "source": "./src/server/pairing-offer.ts",
      "default": "./dist/server/server/pairing-offer.js"
    },
    "./agent-activity": {
      "types": "./dist/server/server/agent/activity-curator.d.ts",
      "source": "./src/server/agent/activity-curator.ts",
      "default": "./dist/server/server/agent/activity-curator.js"
    },
    "./agent-response": {
      "types": "./dist/server/server/agent/agent-response-loop.d.ts",
      "source": "./src/server/agent/agent-response-loop.ts",
      "default": "./dist/server/server/agent/agent-response-loop.js"
    }
  },
  "scripts": {
    "dev": "cross-env PIMI_NODE_ENV=development node --import tsx scripts/dev-runner.ts",
    "dev:tsx": "cross-env PIMI_NODE_ENV=development tsx watch --ignore '**/*.timestamp-*' scripts/dev-runner.ts",
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run build:lib && npm run build:scripts",
    "build:clean": "npm run clean && npm run build",
    "build:lib": "tsc -p tsconfig.server.json --incremental false && node scripts/build-opencode-bridge-plugin.mjs && node scripts/build-terminal-worker.mjs && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/server/server/speech/providers/local/sherpa/assets',{recursive:true}); fs.copyFileSync('src/server/speech/providers/local/sherpa/assets/silero_vad.onnx','dist/server/server/speech/providers/local/sherpa/assets/silero_vad.onnx'); fs.cpSync('src/server/pimi-spaces-embedding-assets','dist/server/server/pimi-spaces-embedding-assets',{recursive:true}); fs.cpSync('src/terminal/shell-integration','dist/server/terminal/shell-integration',{recursive:true}); fs.cpSync('src/terminal/shell-integration','dist/src/terminal/shell-integration',{recursive:true}); fs.copyFileSync('src/terminal/terminal-ts-loader.mjs','dist/server/terminal/terminal-ts-loader.mjs'); fs.rmSync('dist/server/skills',{recursive:true,force:true}); fs.cpSync('../../skills','dist/server/skills',{recursive:true}); fs.rmSync('dist/server/builtin-plugins',{recursive:true,force:true}); fs.cpSync('../../plugins','dist/server/builtin-plugins',{recursive:true,filter:(source)=>!source.split(require('node:path').sep).some((segment)=>segment==='node_modules'||segment==='test')&&!/\\.(test|spec)\\.[cm]?[jt]sx?$/.test(source)&&!source.endsWith('.tsbuildinfo')});\"",
    "build:scripts": "tsc -p tsconfig.scripts.json --incremental false && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/scripts',{recursive:true}); fs.copyFileSync('scripts/mcp-stdio-socket-bridge-cli.mjs','dist/scripts/mcp-stdio-socket-bridge-cli.mjs');\"",
    "prepack": "npm run build:clean",
    "start": "node dist/scripts/supervisor-entrypoint.js",
    "typecheck": "tsgo -p tsconfig.server.typecheck.json --noEmit",
    "generate:config-schema": "tsx scripts/generate-config-schema.ts",
    "measure:agent-tools": "tsx scripts/measure-agent-tools-context.ts",
    "measure:git-observation": "tsx scripts/measure-git-observation.ts",
    "measure:file-observer": "tsx scripts/measure-file-observer.ts",
    "analyze:observer-metrics": "tsx scripts/analyze-observer-metrics.ts",
    "repro:file-observer-teardown": "tsx scripts/reproduce-file-observer-teardown.ts",
    "speech:models": "tsx scripts/list-speech-models.ts",
    "speech:download": "tsx scripts/download-speech-models.ts",
    "speech:transcribe:local": "tsx scripts/transcribe-local-wav.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.17.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opencode-ai/sdk": "1.14.46",
    "@opencode/client": "2.0.10",
    "@pimi/client": "0.17.30",
    "@pimi/highlight": "0.17.30",
    "@pimi/plugin": "0.17.30",
    "@pimi/protocol": "0.17.30",
    "@pimi/relay": "0.17.30",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.330",
    "@xterm/headless": "6.1.0-beta.334",
    "ajv": "8.20.0",
    "bcryptjs": "3.0.3",
    "esbuild": "0.25.12",
    "express": "4.22.1",
    "htmlparser2": "12.0.0",
    "https-proxy-agent": "7.0.6",
    "lru-cache": "11.5.1",
    "markdown-it": "15.0.3",
    "mnemonic-id": "3.2.7",
    "node-pty": "1.2.0-beta.15",
    "openai": "6.44.0",
    "p-limit": "7.3.0",
    "p-throttle": "8.1.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "qrcode": "1.5.4",
    "rotating-file-stream": "3.2.9",
    "semver": "7.8.5",
    "sherpa-onnx-node": "1.12.28",
    "tree-kill": "1.2.2",
    "typescript": "5.9.3",
    "undici": "7.30.2",
    "which": "5.0.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.37",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "cross-env": "10.1.0",
    "tsx": "4.21.0"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
