{
  "name": "@pimi/relay",
  "version": "0.17.38",
  "private": true,
  "description": "Pimi relay for bridging daemon and client connections",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./e2ee": {
      "types": "./dist/e2ee.d.ts",
      "default": "./dist/e2ee.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "build:node-relay": "node scripts/build-node-relay.mjs",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "base64-js": "1.5.1"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "typescript": "5.9.3"
  }
}
