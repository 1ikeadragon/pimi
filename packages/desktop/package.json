{
  "name": "@pimi/desktop",
  "version": "0.17.37",
  "private": true,
  "description": "Pimi desktop app (Electron)",
  "homepage": "https://1ikeadragon.github.io/pimi/",
  "license": "Apache-2.0",
  "author": {
    "name": "Pimi contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1ikeadragon/pimi.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "npm --prefix ../.. run build:server:clean && npm run build:main && electron-builder --config electron-builder.yml",
    "build:mac-helper": "node scripts/build-mac-helper.mjs",
    "build:win-helper": "node scripts/build-win-helper.mjs",
    "build:main": "tsc -p tsconfig.json && node scripts/copy-pimi.mjs",
    "capture-harness": "npm run build:main && ./capture-harness/run.sh",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "verify:electron-cdp": "node ./scripts/verify-electron-cdp.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pimi/cli": "*",
    "@pimi/client": "*",
    "@pimi/highlight": "*",
    "@pimi/server": "*",
    "electron-log": "5.4.3",
    "markdown-it": "15.0.3",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/ws": "8.18.1",
    "electron": "44.10.2",
    "typescript": "5.9.3",
    "unzip-crx-3": "0.2.0",
    "wait-on": "8.0.5"
  },
  "desktopName": "Pimi.desktop"
}
