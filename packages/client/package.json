{
  "name": "@pimi/client",
  "version": "0.17.34",
  "private": true,
  "description": "Pimi client SDK package",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/daemon-client": {
      "types": "./dist/daemon-client.d.ts",
      "default": "./dist/daemon-client.js"
    },
    "./internal/daemon-client-transport-types": {
      "types": "./dist/daemon-client-transport-types.d.ts",
      "default": "./dist/daemon-client-transport-types.js"
    },
    "./internal/daemon-client-websocket-transport": {
      "types": "./dist/daemon-client-websocket-transport.d.ts",
      "default": "./dist/daemon-client-websocket-transport.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./internal/hosts": {
      "types": "./dist/hosts/index.d.ts",
      "default": "./dist/hosts/index.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run build --workspace=@pimi/protocol && npm run build --workspace=@pimi/relay && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "typecheck:examples": "tsgo -p tsconfig.examples.json --noEmit"
  },
  "dependencies": {
    "@pimi/protocol": "0.17.34",
    "@pimi/relay": "0.17.34",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "typescript": "5.9.3"
  }
}
