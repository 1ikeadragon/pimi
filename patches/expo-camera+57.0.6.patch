+++ b/node_modules/expo-camera/android/src/main/java/expo/modules/camera/analyzers/OfflineQrAnalyzer.kt
@@ -0,0 +1,57 @@
+package expo.modules.camera.analyzers
+
+import android.os.Bundle
+import androidx.camera.core.ImageAnalysis
+import androidx.camera.core.ImageProxy
+import com.google.zxing.BinaryBitmap
+import com.google.zxing.PlanarYUVLuminanceSource
+import com.google.zxing.ReaderException
+import com.google.zxing.common.HybridBinarizer
+import com.google.zxing.qrcode.QRCodeReader
+import expo.modules.camera.records.BarcodeType
+import expo.modules.camera.utils.BarCodeScannerResult
+import kotlin.math.roundToInt
+
+class OfflineQrAnalyzer(
+  private val onComplete: (BarCodeScannerResult) -> Unit
+) : ImageAnalysis.Analyzer {
+  private val reader = QRCodeReader()
+  private var pixels = ByteArray(0)
+
+  override fun analyze(image: ImageProxy) {
+    try {
+      val width = image.width
+      val height = image.height
+      val luma = image.planes[0]
+      val buffer = luma.buffer
+      if (pixels.size != width * height) {
+        pixels = ByteArray(width * height)
+      }
+      // YUV_420_888 guarantees a one-byte Y pixel. Padding after the last row
+      // may be absent, so copy only the visible pixels from each row.
+      val offset = buffer.position()
+      for (row in 0 until height) {
+        buffer.position(offset + row * luma.rowStride)
+        buffer.get(pixels, row * width, width)
+      }
+      val source = PlanarYUVLuminanceSource(pixels, width, height, 0, 0, width, height, false)
+      val result = reader.decode(BinaryBitmap(HybridBinarizer(source)))
+      val corners = result.resultPoints.flatMap { listOf(it.x.roundToInt(), it.y.roundToInt()) }
+      onComplete(
+        BarCodeScannerResult(
+          BarcodeType.QR.mapToBarcode(),
+          result.text,
+          result.text,
+          Bundle.EMPTY,
+          corners.toMutableList(),
+          height,
+          width
+        )
+      )
+    } catch (_: ReaderException) {
+      // A frame without a readable QR code is normal while aiming the camera.
+    } finally {
+      image.close()
+    }
+  }
+}
