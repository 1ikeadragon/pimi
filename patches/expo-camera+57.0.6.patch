diff --git a/node_modules/expo-camera/android/src/main/java/expo/modules/camera/analyzers/OfflineQrAnalyzer.kt b/node_modules/expo-camera/android/src/main/java/expo/modules/camera/analyzers/OfflineQrAnalyzer.kt
